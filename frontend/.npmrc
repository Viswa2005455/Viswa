# Works around an npm peer-dependency resolver bug with this dependency set.
legacy-peer-deps=true
# Be patient on slow or unstable connections: retry failed downloads, use fewer parallel
# connections (fewer "ECONNRESET" errors on weak Wi-Fi/mobile data) and allow long timeouts.
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
maxsockets=4
audit=false
fund=false
