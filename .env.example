# Copy this file to backend/.env and fill in values. Never commit the real .env.

# --- Server ---
FIS_ENV=development
FIS_CORS_ORIGINS=http://localhost:5173
FIS_STORAGE_DIR=./storage

# --- Upload limits ---
FIS_MAX_UPLOAD_MB=25
FIS_MAX_FILES_PER_REQUEST=10
FIS_ZIP_MAX_ENTRIES=200
FIS_ZIP_MAX_UNCOMPRESSED_MB=100

# --- AI provider (optional; core calculations work without it) ---
# Supported values: none, anthropic
FIS_AI_PROVIDER=none
# Server-side only. Never put this key in frontend code.
ANTHROPIC_API_KEY=
FIS_AI_MODEL=claude-sonnet-5-5

# --- Database (Phase 7; not used yet) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_studio
