# Copy this file to backend/.env and fill in values. Never commit the real .env.

# --- Server ---
FIS_ENV=development
FIS_CORS_ORIGINS=http://localhost:5173
FIS_STORAGE_DIR=./storage

# --- Upload limits ---
FIS_MAX_UPLOAD_MB=25
FIS_MAX_FILES_PER_REQUEST=10
FIS_ZIP_MAX_ENTRIES=200
FIS_ZIP_MAX_UNCOMPRESSED_MB=100

# --- AI provider (optional; core calculations work without it) ---
# Supported values: none, anthropic
FIS_AI_PROVIDER=none
# Server-side only. Never put this key in frontend code.
ANTHROPIC_API_KEY=
FIS_AI_MODEL=claude-opus-5-5
# Allowed models: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5 (users can pick one per question).
# Per-attempt timeout, SDK retries (429, 5xx, network) and the time limit for one whole answer.
FIS_AI_TIMEOUT_SECONDS=120
FIS_AI_MAX_RETRIES=2
FIS_AI_DEADLINE_SECONDS=300

# --- Live share prices (optional; the Markets page can also analyse uploaded price files) ---
# Supported values: none, eodhd (NSE, BSE and ~70 exchanges), twelvedata (US on the free plan).
# Server-side only. Free/personal provider plans are for your own use; showing the data to other
# people needs the provider's commercial licence. "demo" works with eodhd for AAPL.US, TSLA.US, AMZN.US.
FIS_MARKET_PROVIDER=none
FIS_MARKET_API_KEY=

# --- Database ---
# Leave this commented out to use the built-in database file (what the one-click launchers do).
# Remove the # only if PostgreSQL is installed and running. Production MUST use a different password.
# DATABASE_URL=postgresql+psycopg://fis_app:fis_dev_password@localhost:5432/finance_studio

# --- Accounts, sessions and retention ---
FIS_SESSION_DAYS=14
FIS_UPLOAD_RETENTION_DAYS=90
FIS_ALLOW_REGISTRATION=true
# Cookies are Secure automatically when FIS_ENV=production. Uncomment only to override.
# FIS_COOKIE_SECURE=true
